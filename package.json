{
  "name": "online-library-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"npm run b-dev\" \"npm run f-dev\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"npm run b-start\" \"npm run f-preview\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "b-dev": "npm run dev -w backend",
    "b-build": "npm run build -w backend",
    "b-start": "npm start -w backend",
    "f-dev": "npm run dev -w frontend",
    "f-build": "npm run build -w frontend",
    "f-preview": "npm run preview -w frontend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
